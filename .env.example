# Gnani API Config
GNANI_API_KEY=your_gnani_api_key_here
GNANI_BASE_URL=https://api.vachana.ai
GNANI_TTS_MODEL=timbre-v2.5
GNANI_SAMPLE_RATE=48000

# Groq LLM Config
GROQ_API_KEY=your_groq_api_key_here
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_HEAVY_MODEL=llama-3.3-70b-versatile

# Gemini Fallback Config
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Gateway & Budget Config
BUDGET_DB_PATH=metrics.db
AUDIO_CACHE_DIR=audio_cache
CACHE_MAX_BYTES=268435456  # 256 MB
KILL_SWITCH=0
MOCK_APIS=1  # Default to 1 (offline mock) to protect API credits unless explicitly run live
